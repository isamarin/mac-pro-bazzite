[Unit]
Description=Mac Pro 6,1 fan at maximum (applesmc manual mode)
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'd=/sys/devices/platform/applesmc.768; echo 1 > $d/fan1_manual && cat $d/fan1_max > $d/fan1_output'
ExecStop=/bin/sh -c 'echo 0 > /sys/devices/platform/applesmc.768/fan1_manual'

[Install]
WantedBy=multi-user.target
