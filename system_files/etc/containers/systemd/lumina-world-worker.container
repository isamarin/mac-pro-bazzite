[Unit]
Description=lumina-world worker igrs.lumina.node.0
Wants=network-online.target
After=network-online.target postgis.service
Requires=postgis.service

[Container]
# Built locally by lumina-world/images/build.sh (docker build, then loaded into podman)
Image=docker.io/lumina-world/node:latest
Pull=never
ContainerName=lumina-world-worker
# lets the worker finish the current task on stop instead of losing it after 10 s
StopTimeout=600
Environment=LUMINA_WORLD_NODE=igrs.lumina.node.0
# N builder processes sized by node memory and the peak RSS of its recent build runs;
# a stop is forwarded to every builder, each finishes its current task
# all 24 threads: the user runs this Mac Pro flat out (fan at max via mac-fan-max.service);
# the worker's thermal guard stops leasing builds at 95 °C and resumes at 88 °C (sensor crit is 99 °C)
Environment=LUMINA_WORLD_THERMAL_PAUSE_C=95
Environment=LUMINA_WORLD_THERMAL_RESUME_C=88
Exec=lumina-world worker --node igrs.lumina.node.0 --jobs 24
EnvironmentFile=/etc/lumina-world/node.env
Volume=/var/lib/lumina-world:/data:Z
# host OS for the hardware snapshot in the build journal (the container is Debian)
Volume=/etc/os-release:/run/host/os-release:ro

[Service]
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
