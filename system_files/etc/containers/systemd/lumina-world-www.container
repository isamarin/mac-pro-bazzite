[Unit]
Description=lumina-world static server (published tiles, region catalogs, packs)
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/library/nginx:1.27-alpine
ContainerName=lumina-world-www
# Loopback only: the host nginx (conf.d/gitlab.conf) proxies /world/ here
PublishPort=127.0.0.1:8930:80
# Written by the worker's `publish`; :z (shared label) because the worker mounts the same tree
Volume=/var/lib/lumina-world/publish:/usr/share/nginx/html/world:ro,z
ReadOnly=true
# podman's ReadOnly=true already mounts tmpfs on /run, /tmp and /dev (--read-only-tmpfs default)
Tmpfs=/var/cache/nginx

[Service]
# the bind source must exist before podman starts (a fresh node has no publish/ yet)
ExecStartPre=/usr/bin/mkdir -p /var/lib/lumina-world/publish
Restart=always

[Install]
WantedBy=multi-user.target
